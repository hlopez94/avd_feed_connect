From 129b82a878e6ef308cae2a12250f998779acdf3a Mon Sep 17 00:00:00 2001
From: Ewerton Mattos <ewer@outlook.com>
Date: Tue, 13 Oct 2026 16:10:58 -0300
Subject: [PATCH] [client,sdl] strip the terminating \0 from text for local
 applications

Since e0931b4af9 the WinPR string synthesizers include the terminating
\0 in the returned size, as the RDP wire formats require. The SDL client
handed that size straight to SDL, so every text copied from the server
reached local applications with a trailing \0, which they show as a
stray character at the end of the paste.

Cut text at the first \0 before handing it to SDL, as the X11 client
already does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 client/SDL/SDL3/sdl_clip.cpp | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/client/SDL/SDL3/sdl_clip.cpp b/client/SDL/SDL3/sdl_clip.cpp
index 35e8af8..83c8f0b 100644
--- a/client/SDL/SDL3/sdl_clip.cpp
+++ b/client/SDL/SDL3/sdl_clip.cpp
@@ -25,6 +25,7 @@
 #include <iterator>
 #include <algorithm>
 #include <utility>
+#include <cstring>
 
 #include <winpr/wlog.h>
 #include <winpr/image.h>
@@ -153,6 +154,18 @@ static const char s_mime_html[] = "text/html";
 	return nullptr;
 }
 
+/* WinPR synthesizes text with its terminating '\0' included in the size, as the RDP
+ * wire formats require. Local applications expect the bare string, so cut it at the
+ * first '\0' (as the X11 client does). */
+[[nodiscard]] static uint32_t textLength(const void* data, uint32_t size)
+{
+	const auto end = memchr(data, '\0', size);
+	if (!end)
+		return size;
+	return WINPR_ASSERTING_INT_CAST(uint32_t,
+	                                static_cast<const char*>(end) - static_cast<const char*>(data));
+}
+
 static const char s_mime_gnome_copied_files[] = "x-special/gnome-copied-files";
 static const char s_mime_mate_copied_files[] = "x-special/mate-copied-files";
 
@@ -1111,6 +1124,8 @@ const void* sdlClip::ClipDataCb(void* userdata, const char* mime_type, size_t* s
 		if (fptr)
 		{
 			auto ptr = std::shared_ptr<void>(fptr, free);
+			if (mime_is_text(mime_type))
+				fsize = textLength(fptr, fsize);
 			clip->_cache_data.insert({ mime_type, { fsize, ptr } });
 
 			auto fcache = clip->_cache_data.find(mime_type);
@@ -1187,6 +1202,8 @@ const void* sdlClip::ClipDataCb(void* userdata, const char* mime_type, size_t* s
 			}
 
 			auto ptr = std::shared_ptr<void>(data, free);
+			if (mime_is_text(mime_type))
+				len = textLength(data, len);
 			clip->_cache_data.insert({ mime_type, { len, ptr } });
 			*size = len;
 			return ptr.get();
-- 
2.55.0

